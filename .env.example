# 미디어 송출기 설정 예시 — `.env` 로 복사해서 수정하세요 (copy .env.example .env)

# 관리 웹
PORT=8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# 송출 URL 에 표시할 호스트(IP/도메인). 비워 두면 LAN IP 를 자동 감지합니다.
PUBLIC_HOST=

# VOD 로 송출할 미디어 파일 폴더 (앱 폴더 기준 상대 경로 가능). 없으면 자동으로 만듭니다.
VOD_DIR=media

# MediaMTX 설정(포트, 프로토콜, 녹화 등)은 mediamtx.yml 에서 관리합니다. 관리 화면 > 설정 탭에서 수정하세요.
