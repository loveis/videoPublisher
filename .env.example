# 미디어 송출기 설정 예시 — `.env` 로 복사해서 수정하세요 (copy .env.example .env)

# 관리 웹
PORT=8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# 송출 URL 에 표시할 호스트(IP/도메인). 비워 두면 LAN IP 를 자동 감지합니다.
PUBLIC_HOST=

# MediaMTX 포트 (이미 사용 중이면 다른 값으로 변경)
RTSP_PORT=8554
WEBRTC_PORT=8889
WEBRTC_UDP_PORT=8189
MEDIAMTX_API_PORT=9997
